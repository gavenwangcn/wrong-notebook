<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 服务端多部署在局域网，允许 HTTP；HTTPS 同时信任用户安装的证书（自签名 CA） -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
